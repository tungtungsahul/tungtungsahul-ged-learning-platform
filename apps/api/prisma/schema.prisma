generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Subject {
  MATH
  SCIENCE
  SOCIAL_STUDIES
  RLA
  LISTENING
  SPEAKING
  READING
  WRITING
}

enum ExamMode {
  PRACTICE
  MOCK
  SKILL
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_BLANK
  DROPDOWN
  TRUE_FALSE
  SHORT_ANSWER
  DRAG_DROP
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model Course {
  id          String   @id @default(cuid())
  title       String
  subject     Subject
  description String
  progress    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  modules     Module[]
  exams       Exam[]
  mistakes    Mistake[]
  flashcards  Flashcard[]
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id       String   @id @default(cuid())
  moduleId String
  title    String
  content  String
  order    Int
  module   Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Exam {
  id              String         @id @default(cuid())
  courseId        String
  title           String
  description     String
  subject         Subject
  mode            ExamMode       @default(PRACTICE)
  durationSeconds Int
  passingScore    Int             @default(60)
  gedScaleMin     Int             @default(100)
  gedScaleMax     Int             @default(200)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  passages        Passage[]
  questions       Question[]
  attempts        Attempt[]
  schedules       ExamSchedule[]
}

model Passage {
  id        String     @id @default(cuid())
  examId    String
  title     String
  content   String
  assetUrl  String?
  order     Int
  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions Question[]
  audio     AudioAsset?
}

model AudioAsset {
  id          String  @id @default(cuid())
  passageId   String  @unique
  url         String
  transcript  String?
  passage     Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)
}

model Question {
  id           String         @id @default(cuid())
  examId       String
  passageId    String?
  text         String
  type         QuestionType   @default(MULTIPLE_CHOICE)
  explanation  String
  difficulty   Difficulty     @default(MEDIUM)
  points       Int            @default(1)
  topic        String         @default("General")
  data         Json?
  order        Int
  exam         Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  passage      Passage?       @relation(fields: [passageId], references: [id], onDelete: SetNull)
  options      Option[]
  answers      Answer[]
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  label      String
  text       String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    Answer[]
}

model Attempt {
  id            String        @id @default(cuid())
  learnerId     String
  examId        String
  startedAt     DateTime      @default(now())
  expiresAt     DateTime
  submittedAt   DateTime?
  status        AttemptStatus @default(IN_PROGRESS)
  score         Int?
  percentage    Int?
  gedScore      Int?
  workspaceState Json?
  exam          Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers       Answer[]
  result        Result?
}

model Answer {
  id               String   @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  textValue        String?
  payload          Json?
  answeredAt       DateTime @updatedAt
  attempt          Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   Option?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
}

model Result {
  id               String   @id @default(cuid())
  attemptId        String   @unique
  correctAnswers   Int
  incorrectAnswers Int
  unanswered       Int
  percentage       Int
  gedScore         Int
  passed           Boolean
  timeUsedSeconds  Int
  details           Json?
  attempt           Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model ExamSchedule {
  id          String   @id @default(cuid())
  examId      String
  scheduledAt DateTime
  label       String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model Mistake {
  id          String   @id @default(cuid())
  courseId    String
  learnerId   String
  questionId  String
  topic       String
  note        String?
  reviewed    Boolean @default(false)
  createdAt   DateTime @default(now())
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Flashcard {
  id        String   @id @default(cuid())
  courseId  String
  front     String
  back      String
  tags      String[]
  createdAt DateTime @default(now())
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model TutorConversation {
  id        String        @id @default(cuid())
  learnerId String
  subject   Subject?
  examId    String?
  attemptId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  TutorMessage[]
}

model TutorMessage {
  id             String            @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime          @default(now())
  conversation   TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
